model Property {
  id                Int               @id @default(autoincrement())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime @updatedAt()
  availableFrom     DateTime
  title             String
  description       String

 
  monthlyRent     Decimal           @db.Decimal(10, 2)
  deposit           Decimal?          @db.Decimal(10, 2)
  nsfasAccredited   Boolean           @default(false)
  utilitiesIncluded Boolean           @default(true) 
  studentFriendly   Boolean           @default(true)
  furnished         Boolean           @default(true)
  parking           Boolean           @default(true)
  gas               Int?
  water             Int?
  electricity       Int?
  availableRooms    Int
  bathrooms         Int
  landlordId        Int
  
  province          String
  town              String
  suburb            String
  address           String
  genderPreferences GenderRestriction
  propertyType      PropertyType
  
  rules             String[]
  amenities         String[]
  nearbyPlaces      NearbyPlace[]
  user              User              @relation(fields: [landlordId], references: [id])
}

model User {
  id       Int        @id @default(autoincrement())
  username String     
  email    String     @unique
  password String
  role     Role       @default(TENANT)
  //Comment  Comment[]
  PropertIES Property[]
}

enum GenderRestriction {
  Male
  Female
  Mixed
  Non_binary
}

enum PropertyType {
  Single_room
  Sharing_room
  Student_accommodation
  Guesthouse
  Flat
  Apartment
  House
  Cottage
}

enum Role {
  LANDLORD
  TENANT
  //ADMIN
}
